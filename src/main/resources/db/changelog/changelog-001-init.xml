    <changeSet id="5" author="lipov">
        <insert tableName="unit">
            <column name="name" value="Drużyna Alpha"/>
            <column name="type" value="infantry"/>
            <column name="faction" value="Czerwoni"/>
            <column name="strength" value="100"/>
            <column name="status" value="ACTIVE"/>
        </insert>
    </changeSet>

</databaseChangeLog>
